# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deck-store
REDIS_URL=redis://localhost:6379

# Medusa Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production
COOKIE_SECRET=your_super_secret_cookie_key_here_change_this_in_production
NODE_ENV=development

# Store URLs
STORE_URL=http://localhost:3000
ADMIN_URL=http://localhost:9000

# Stripe Configuration
STRIPE_API_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# AWS S3 Configuration
S3_URL=https://s3.amazonaws.com
S3_BUCKET=deck-store
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# Email Configuration (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
FROM_EMAIL=noreply@deckclothing.com
