    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.2.0",
    "medusa-interfaces": "^1.3.7",
    "medusa-payment-stripe": "^6.0.11",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "typeorm": "^0.3.17"
