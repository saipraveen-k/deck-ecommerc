{
  "name": "@deck/backend",
  "version": "1.0.0",
  "description": "Medusa backend for Deck e-commerce",
  "main": "dist/index.js",
  "scripts": {
    "clean": "cross-env rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
